[Unit]
Description=YC Auto Apply - Daily Job Applications
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/run/media/jeet/New Volume/yc-auto-apply
ExecStart=/usr/bin/node auto-apply-runner.js yc --live
Environment=HOME=/home/jeet
TimeoutStartSec=6600
StandardOutput=append:/run/media/jeet/New Volume/yc-auto-apply/cron.log
StandardError=append:/run/media/jeet/New Volume/yc-auto-apply/cron.log
